# PostgreSQL connection (Railway injects DATABASE_URL automatically when you add a Postgres plugin)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hbj_archive?schema=public"
REDIS_URL="redis://localhost:6379"

# S3-compatible object storage (works with AWS S3, MinIO, DigitalOcean
# Spaces, Cloudflare R2, or Railway's own bucket plugin — anything that
# speaks the S3 API).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="hbj-archive-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# App
PORT=3000
NODE_ENV=development
